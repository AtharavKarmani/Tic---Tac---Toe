public class BoardUtils {

    public static int[] getRowCol(int slot) {
        int row = (slot - 1) / 3;
        int col = (slot - 1) % 3;

        return new int[]{row, col};
    }
}int slot = 5;

int[] position = BoardUtils.getRowCol(slot);

System.out.println("Row: " + position[0]);
System.out.println("Col: " + position[1]);